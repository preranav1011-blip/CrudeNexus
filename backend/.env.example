# Environment configuration for CrudeNexus backend
# Copy this to .env and fill in values as needed

# Application
DEBUG=True
APP_NAME=CrudeNexus
APP_VERSION=0.1.0

# Database
DATABASE_URL=sqlite:///./crudenexus.db

# LLM Configuration (Ollama)
LLM_ENABLED=True
LLM_PROVIDER=ollama
LLM_MODEL=qwen:8b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=30

# GDELT Configuration
GDELT_LOOKBACK_HOURS=24

# India-specific
INDIA_CRUDE_DEMAND_MBD=4.5
